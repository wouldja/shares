pkgname=shares
pkgver=0.2.2
pkgrel=1
pkgdesc='Publish folders over Samba, NFS, iSCSI, and S3'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
optdepends=(
  'polkit: confirm a save'
  'samba: SMB shares'
  'nfs-utils: NFS exports'
  'targetcli-fb: iSCSI targets'
  'mc: MinIO buckets'
  'garage: Garage buckets'
  'ceph: Ceph object gateway'
  'curl: RustFS admin API'
)
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/shares "$pkgdir/usr/bin/shares"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/shares.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/shares.svg"
  install -Dm644 "$startdir/shares.desktop" "$pkgdir/usr/share/applications/shares.desktop"
  install -Dm644 "$startdir/org.shares.manage.policy" "$pkgdir/usr/share/polkit-1/actions/org.shares.manage.policy"
}
