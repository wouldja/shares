<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Shares</vendor>
  <vendor_url>https://github.com/wouldja/shares</vendor_url>
  <action id="org.shares.manage">
    <description>Change published folders</description>
    <message>Authentication is required to change Samba, NFS, iSCSI, or S3 shares</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/shares</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--privileged</annotate>
  </action>
</policyconfig>
